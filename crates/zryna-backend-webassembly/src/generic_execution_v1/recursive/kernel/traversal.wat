;; Compiler-private traversal template. Metadata and address authority are supplied
;; and independently verified by the owning Rust integration, never inferred here.
(module
  (import "zryna.private" "copy" (func $copy (param i32 i32 i32)))
  (import "zryna.private" "stringClone" (func $stringClone (param i32 i32 i32 i32) (result i32)))
  (import "zryna.private" "stringRelease" (func $stringRelease (param i32 i32 i32) (result i32)))
  (import "zryna.private" "vecAllocate" (func $vecAllocate (param i32 i32 i32) (result i32)))
  (import "zryna.private" "vecReleaseStorage" (func $vecRelease (param i32 i32 i32 i32) (result i32)))
  (import "zryna.private" "strongClone" (func $strongClone (param i32) (result i32)))
  (import "zryna.private" "weakClone" (func $weakClone (param i32) (result i32)))
  (import "zryna.private" "strongBegin" (func $strongBegin (param i32 i32) (result i32)))
  (import "zryna.private" "strongFinish" (func $strongFinish (param i32) (result i32)))
  (import "zryna.private" "weakRelease" (func $weakRelease (param i32 i32) (result i32)))
  (import "zryna.private" "memory" (memory 256 256))
  (import "zryna.private" "metadata" (global $metadata i32))
  (import "zryna.private" "arena" (global $arena i32))
  (import "zryna.private" "capacity" (global $capacity i32))
  (import "zryna.private" "used" (global $used (mut i32)))
  (import "zryna.private" "scratch" (global $scratch i32))

  (func $row (param $ty i32) (result i32)
    (if (i32.ge_u (local.get $ty) (i32.load (global.get $metadata))) (then unreachable))
    (i32.add (i32.add (global.get $metadata) (i32.const 16))
      (i32.mul (local.get $ty) (i32.const 32))))
  (func $member (param $index i32) (result i32)
    (if (i32.ge_u (local.get $index) (i32.load offset=4 (global.get $metadata))) (then unreachable))
    (i32.add (i32.load offset=8 (global.get $metadata))
      (i32.mul (local.get $index) (i32.const 12))))
  (func $packed (param $ty i32) (param $offset i32) (result i64)
    (i64.or (i64.shl (i64.extend_i32_u (local.get $ty)) (i64.const 32))
      (i64.extend_i32_u (local.get $offset))))
  (func $save (param $ty i32) (param $root i32) (param $cursor i32) (param $reverse i32)
    (i64.store (i32.add (global.get $scratch) (i32.const 0))
      (call $find (local.get $ty) (local.get $root) (local.get $cursor) (local.get $reverse))))
  (func $foundType (result i32)
    (i32.load offset=4 (global.get $scratch)))
  (func $foundOffset (result i32)
    (i32.load offset=0 (global.get $scratch)))

  ;; Recursion follows only inline layout edges, whose DAG is independently proved.
  ;; Owned heap indirections are leaves; their depth never consumes the Wasm stack.
  (func $find (export "find") (param $ty i32) (param $root i32)
    (param $cursor i32) (param $reverse i32) (result i64)
    (local $r i32) (local $kind i32) (local $i i32) (local $count i32)
    (local $m i32) (local $child i32) (local $offset i32) (local $next i32)
    (local $stride i32) (local $tag i32)
    (local.set $r (call $row (local.get $ty)))
    (if (i32.eqz (i32.load offset=4 (local.get $r))) (then (return (i64.const -1))))
    (local.set $kind (i32.load (local.get $r)))
    (if (i32.or (i32.eq (local.get $kind) (i32.const 0))
                (i32.eq (local.get $kind) (i32.const 1))) (then (return (i64.const -1))))
    (if (i32.or (i32.eq (local.get $kind) (i32.const 2))
                (i32.ge_u (local.get $kind) (i32.const 6)))
      (then
        (if (i32.gt_u (local.get $kind) (i32.const 8)) (then unreachable))
        (if (if (result i32) (local.get $reverse)
              (then (i32.ne (local.get $cursor) (i32.const 0)))
              (else (i32.eqz (local.get $cursor))))
          (then (return (call $packed (local.get $ty) (i32.const 0)))))
        (return (i64.const -1))))
    (local.set $count (i32.load offset=20 (local.get $r)))
    (if (i32.eq (local.get $kind) (i32.const 5))
      (then
        (local.set $stride (i32.load offset=24 (local.get $r)))
        (if (i32.or (i32.eqz (local.get $stride)) (i32.eqz (local.get $count)))
          (then (return (i64.const -1))))
        (if (local.get $reverse)
          (then
            (if (i32.eqz (local.get $cursor)) (then (return (i64.const -1))))
            (local.set $i (i32.div_u (i32.sub (local.get $cursor) (i32.const 1)) (local.get $stride)))
            (if (i32.ge_u (local.get $i) (local.get $count))
              (then (local.set $i (i32.sub (local.get $count) (i32.const 1))))))
          (else (local.set $i (i32.div_u (local.get $cursor) (local.get $stride)))))
        (block $arrayDone (loop $array
          (br_if $arrayDone (i32.ge_u (local.get $i) (local.get $count)))
          (local.set $offset (i32.mul (local.get $i) (local.get $stride)))
          (local.set $next (i32.sub (local.get $cursor) (local.get $offset)))
          (if (i32.lt_u (local.get $cursor) (local.get $offset))
            (then (local.set $next (i32.const 0))))
          (call $save (i32.load offset=16 (local.get $r))
            (i32.add (local.get $root) (local.get $offset)) (local.get $next) (local.get $reverse))
          (if (i32.ne (call $foundType) (i32.const -1))
            (then (return (call $packed (call $foundType)
              (i32.add (local.get $offset) (call $foundOffset))))))
          (if (local.get $reverse)
            (then
              (br_if $arrayDone (i32.eqz (local.get $i)))
              (local.set $i (i32.sub (local.get $i) (i32.const 1))))
            (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))
          (br $array)))
        (return (i64.const -1))))
    (if (i32.eq (local.get $kind) (i32.const 4))
      (then (local.set $tag (i32.load (local.get $root))))
      (else (if (i32.ne (local.get $kind) (i32.const 3)) (then unreachable))))
    (local.set $i (if (result i32) (local.get $reverse)
      (then (local.get $count)) (else (i32.const 0))))
    (block $membersDone (loop $members
      (if (local.get $reverse)
        (then
          (br_if $membersDone (i32.eqz (local.get $i)))
          (local.set $i (i32.sub (local.get $i) (i32.const 1))))
        (else (br_if $membersDone (i32.ge_u (local.get $i) (local.get $count)))))
      (local.set $m (call $member (i32.add (i32.load offset=16 (local.get $r)) (local.get $i))))
      (if (i32.or (i32.eq (local.get $kind) (i32.const 3))
                  (i32.eq (i32.load (local.get $m)) (local.get $tag)))
        (then
          (local.set $child (i32.load offset=4 (local.get $m)))
          (if (i32.ne (local.get $child) (i32.const -1))
            (then
              (local.set $offset (i32.load offset=8 (local.get $m)))
              (local.set $next (i32.sub (local.get $cursor) (local.get $offset)))
              (if (i32.lt_u (local.get $cursor) (local.get $offset))
                (then (local.set $next (i32.const 0))))
              (call $save (local.get $child) (i32.add (local.get $root) (local.get $offset))
                (local.get $next) (local.get $reverse))
              (if (i32.ne (call $foundType) (i32.const -1))
                (then (return (call $packed (call $foundType)
                  (i32.add (local.get $offset) (call $foundOffset))))))))
          (if (i32.eq (local.get $kind) (i32.const 4)) (then (return (i64.const -1))))))
      (if (i32.eqz (local.get $reverse))
        (then (local.set $i (i32.add (local.get $i) (i32.const 1)))))
      (br $members)))
    (if (i32.eq (local.get $kind) (i32.const 4)) (then unreachable))
    (i64.const -1))

  (func $zero (param $dst i32) (param $bytes i32)
    (local $i i32)
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $bytes)))
      (i32.store8 (i32.add (local.get $dst) (local.get $i)) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $again))))
  (func $zeroRecord (param $dst i32)
    (i32.store (local.get $dst) (i32.const 0))
    (i32.store offset=4 (local.get $dst) (i32.const 0))
    (i32.store offset=8 (local.get $dst) (i32.const 0)))
  (func $check (param $status i32)
    (if (local.get $status) (then unreachable)))
  (func $init (export "init") (param $ty i32) (param $src i32) (param $dst i32)
    (local $r i32) (local $kind i32) (local $grant i32) (local $i i32)
    (local $count i32) (local $m i32) (local $offset i32) (local $child i32)
    (local.set $r (call $row (local.get $ty)))
    (local.set $grant (i32.load offset=12 (local.get $r)))
    (if (i32.eqz (local.get $grant)) (then unreachable))
    (call $zero (local.get $dst) (i32.load offset=4 (local.get $r)))
    (if (i32.eq (local.get $grant) (i32.const 1))
      (then
        (call $copy (local.get $src) (local.get $dst) (i32.load offset=4 (local.get $r)))
        (return)))
    (local.set $kind (i32.load (local.get $r)))
    (if (i32.or (i32.eq (local.get $kind) (i32.const 2))
                (i32.ge_u (local.get $kind) (i32.const 6)))
      (then
        (if (i32.or (i32.gt_u (local.get $kind) (i32.const 8))
                    (i32.ne (local.get $grant) (local.get $kind))) (then unreachable))
        (return)))
    (local.set $count (i32.load offset=20 (local.get $r)))
    (if (i32.eq (local.get $kind) (i32.const 5))
      (then
        (if (i32.ne (local.get $grant) (i32.const 5)) (then unreachable))
        (block $arrayDone (loop $array
          (br_if $arrayDone (i32.ge_u (local.get $i) (local.get $count)))
          (local.set $offset (i32.mul (local.get $i) (i32.load offset=24 (local.get $r))))
          (call $init (i32.load offset=16 (local.get $r))
            (i32.add (local.get $src) (local.get $offset)) (i32.add (local.get $dst) (local.get $offset)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $array)))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const 4))
      (then
        (if (i32.ne (local.get $grant) (i32.const 3)) (then unreachable))
        (i32.store (local.get $dst) (i32.load (local.get $src))))
      (else
        (if (i32.or (i32.ne (local.get $kind) (i32.const 3))
                    (i32.ne (local.get $grant) (i32.const 4))) (then unreachable))))
    (block $done (loop $members
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $m (call $member (i32.add (i32.load offset=16 (local.get $r)) (local.get $i))))
      (if (i32.or (i32.eq (local.get $kind) (i32.const 3))
                  (i32.eq (i32.load (local.get $m)) (i32.load (local.get $src))))
        (then
          (local.set $child (i32.load offset=4 (local.get $m)))
          (if (i32.ne (local.get $child) (i32.const -1))
            (then
              (local.set $offset (i32.load offset=8 (local.get $m)))
              (call $init (local.get $child) (i32.add (local.get $src) (local.get $offset))
                (i32.add (local.get $dst) (local.get $offset)))))
          (if (i32.eq (local.get $kind) (i32.const 4)) (then (return)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $members)))
    (if (i32.eq (local.get $kind) (i32.const 4)) (then unreachable)))

  ;; Exactly six i32 lanes; all lanes are written before used is committed.
  (func $push (param $a i32) (param $b i32) (param $ty i32)
    (param $offset i32) (param $index i32) (param $role i32)
    (local $p i32)
    (if (i32.ge_u (global.get $used) (global.get $capacity)) (then unreachable))
    (local.set $p (i32.add (global.get $arena) (i32.mul (global.get $used) (i32.const 24))))
    (i32.store (local.get $p) (local.get $a))
    (i32.store offset=4 (local.get $p) (local.get $b))
    (i32.store offset=8 (local.get $p) (local.get $ty))
    (i32.store offset=12 (local.get $p) (local.get $offset))
    (i32.store offset=16 (local.get $p) (local.get $index))
    (i32.store offset=20 (local.get $p) (local.get $role))
    (global.set $used (i32.add (global.get $used) (i32.const 1))))
  (func $top (result i32)
    (if (i32.eqz (global.get $used)) (then unreachable))
    (i32.add (global.get $arena) (i32.mul (i32.sub (global.get $used) (i32.const 1)) (i32.const 24))))
  (func $pop
    (if (i32.eqz (global.get $used)) (then unreachable))
    (global.set $used (i32.sub (global.get $used) (i32.const 1))))
  (func $releaseVec (param $leafType i32) (param $descriptor i32)
    (call $check (call $vecRelease (i32.load offset=16 (call $row (local.get $leafType)))
      (i32.load (local.get $descriptor)) (i32.load offset=4 (local.get $descriptor))
      (i32.load offset=8 (local.get $descriptor))))
    (call $zeroRecord (local.get $descriptor)))

  ;; limit is an exclusive inline leaf-start boundary, not an initialized-byte mask.
  (func $drop (export "drop") (param $ty i32) (param $root i32) (param $limit i32)
    (local $base i32) (local $cursor i32) (local $leaf i32) (local $offset i32)
    (local $r i32) (local $kind i32) (local $address i32) (local $length i32)
    (local $p i32) (local $role i32) (local $index i32) (local $pointer i32)
    (local.set $base (global.get $used))
    (local.set $cursor (local.get $limit))
    (loop $walk
      (call $save (local.get $ty) (local.get $root) (local.get $cursor) (i32.const 1))
      (local.set $leaf (call $foundType))
      (if (i32.ne (local.get $leaf) (i32.const -1))
        (then
          (local.set $offset (call $foundOffset))
          (local.set $r (call $row (local.get $leaf)))
          (local.set $kind (i32.load (local.get $r)))
          (local.set $address (i32.add (local.get $root) (local.get $offset)))
          (if (i32.eq (local.get $kind) (i32.const 2))
            (then
              (call $check (call $stringRelease (i32.load (local.get $address))
                (i32.load offset=4 (local.get $address)) (i32.load offset=8 (local.get $address))))
              (call $zeroRecord (local.get $address))))
          (if (i32.eq (local.get $kind) (i32.const 8))
            (then
              (call $check (call $weakRelease (i32.load (local.get $address))
                (i32.add (global.get $scratch) (i32.const 12))))
              (i32.store (local.get $address) (i32.const 0))))
          (if (i32.eq (local.get $kind) (i32.const 6))
            (then
              (local.set $length (i32.load offset=4 (local.get $address)))
              (if (local.get $length)
                (then
                  (local.set $index (i32.sub (local.get $length) (i32.const 1)))
                  (call $push (local.get $leaf) (local.get $root) (local.get $ty)
                    (local.get $offset) (local.get $index) (i32.const 0))
                  (local.set $root (i32.add (i32.load (local.get $address))
                    (i32.mul (local.get $index) (i32.load offset=24 (local.get $r)))))
                  (local.set $ty (i32.load offset=16 (local.get $r)))
                  (local.set $cursor (i32.load offset=4 (call $row (local.get $ty))))
                  (br $walk)))
              (call $releaseVec (local.get $leaf) (local.get $address))))
          (if (i32.eq (local.get $kind) (i32.const 7))
            (then
              (local.set $pointer (i32.load (local.get $address)))
              (call $check (call $strongBegin (local.get $pointer)
                (i32.add (global.get $scratch) (i32.const 12))))
              (if (i32.load offset=12 (global.get $scratch))
                (then
                  (call $push (local.get $leaf) (local.get $root) (local.get $ty)
                    (local.get $offset) (i32.const 0) (i32.const 1))
                  (local.set $root (i32.add (local.get $pointer) (i32.load offset=28 (local.get $r))))
                  (local.set $ty (i32.load offset=16 (local.get $r)))
                  (local.set $cursor (i32.load offset=4 (call $row (local.get $ty))))
                  (br $walk)))
              (i32.store (local.get $address) (i32.const 0))))
          (local.set $cursor (local.get $offset))
          (br $walk)))
      (if (i32.eq (global.get $used) (local.get $base)) (then (return)))
      (local.set $p (call $top))
      (local.set $leaf (i32.load (local.get $p)))
      (local.set $root (i32.load offset=4 (local.get $p)))
      (local.set $ty (i32.load offset=8 (local.get $p)))
      (local.set $offset (i32.load offset=12 (local.get $p)))
      (local.set $index (i32.load offset=16 (local.get $p)))
      (local.set $role (i32.load offset=20 (local.get $p)))
      (local.set $r (call $row (local.get $leaf)))
      (local.set $address (i32.add (local.get $root) (local.get $offset)))
      (if (i32.eqz (local.get $role))
        (then
          (if (local.get $index)
            (then
              (local.set $index (i32.sub (local.get $index) (i32.const 1)))
              (i32.store offset=16 (local.get $p) (local.get $index))
              (local.set $root (i32.add (i32.load (local.get $address))
                (i32.mul (local.get $index) (i32.load offset=24 (local.get $r)))))
              (local.set $ty (i32.load offset=16 (local.get $r)))
              (local.set $cursor (i32.load offset=4 (call $row (local.get $ty))))
              (br $walk)))
          (call $pop)
          (call $releaseVec (local.get $leaf) (local.get $address)))
        (else
          (if (i32.ne (local.get $role) (i32.const 1)) (then unreachable))
          (local.set $pointer (i32.load (local.get $address)))
          (call $pop)
          (call $check (call $strongFinish (local.get $pointer)))
          (i32.store (local.get $address) (i32.const 0))))
      (local.set $cursor (local.get $offset))
      (br $walk)))

  ;; Clone frames refer only to newly allocated unpublished Vec destinations.
  ;; Shared/Weak are terminal increments of the SAME source control, never frames.
  (func $clone (export "clone") (param $ty i32) (param $src i32) (param $dst i32) (result i32)
    (local $base i32) (local $cursor i32) (local $leaf i32) (local $offset i32)
    (local $r i32) (local $kind i32) (local $source i32) (local $destination i32)
    (local $status i32) (local $length i32) (local $p i32) (local $index i32)
    (local.set $base (global.get $used))
    (call $init (local.get $ty) (local.get $src) (local.get $dst))
    (block $failed (loop $walk
      (call $save (local.get $ty) (local.get $src) (local.get $cursor) (i32.const 0))
      (local.set $leaf (call $foundType))
      (if (i32.ne (local.get $leaf) (i32.const -1))
        (then
          (local.set $offset (call $foundOffset))
          (local.set $r (call $row (local.get $leaf)))
          (local.set $kind (i32.load (local.get $r)))
          (local.set $source (i32.add (local.get $src) (local.get $offset)))
          (local.set $destination (i32.add (local.get $dst) (local.get $offset)))
          (if (i32.eq (local.get $kind) (i32.const 2))
            (then
              (local.set $status (call $stringClone (i32.load (local.get $source))
                (i32.load offset=4 (local.get $source)) (i32.load offset=8 (local.get $source))
                (local.get $destination)))
              (br_if $failed (local.get $status))))
          (if (i32.or (i32.eq (local.get $kind) (i32.const 7))
                      (i32.eq (local.get $kind) (i32.const 8)))
            (then
              (local.set $status (if (result i32) (i32.eq (local.get $kind) (i32.const 7))
                (then (call $strongClone (i32.load (local.get $source))))
                (else (call $weakClone (i32.load (local.get $source))))))
              (br_if $failed (local.get $status))
              (i32.store (local.get $destination) (i32.load (local.get $source)))))
          (if (i32.eq (local.get $kind) (i32.const 6))
            (then
              (local.set $length (i32.load offset=4 (local.get $source)))
              (local.set $status (call $vecAllocate (i32.load offset=16 (local.get $r))
                (local.get $length) (local.get $destination)))
              (br_if $failed (local.get $status))
              (if (local.get $length)
                (then
                  (call $push (local.get $src) (local.get $dst) (local.get $ty)
                    (local.get $offset) (i32.const 0) (i32.const 2))
                  (local.set $src (i32.load (local.get $source)))
                  (local.set $dst (i32.load (local.get $destination)))
                  (local.set $ty (i32.load offset=16 (local.get $r)))
                  (local.set $cursor (i32.const 0))
                  (call $init (local.get $ty) (local.get $src) (local.get $dst))
                  (br $walk)))))
          (local.set $cursor (i32.add (local.get $offset) (i32.const 1)))
          (br $walk)))
      ;; A whole inline element completed. Publish its prefix exactly once.
      (if (i32.eq (global.get $used) (local.get $base)) (then (return (i32.const 0))))
      (local.set $p (call $top))
      (if (i32.ne (i32.load offset=20 (local.get $p)) (i32.const 2)) (then unreachable))
      (local.set $src (i32.load (local.get $p)))
      (local.set $dst (i32.load offset=4 (local.get $p)))
      (local.set $ty (i32.load offset=8 (local.get $p)))
      (local.set $offset (i32.load offset=12 (local.get $p)))
      (local.set $index (i32.add (i32.load offset=16 (local.get $p)) (i32.const 1)))
      (call $save (local.get $ty) (local.get $src) (local.get $offset) (i32.const 0))
      (local.set $leaf (call $foundType))
      (if (i32.or (i32.eq (local.get $leaf) (i32.const -1))
                  (i32.ne (call $foundOffset) (local.get $offset))) (then unreachable))
      (local.set $r (call $row (local.get $leaf)))
      (if (i32.ne (i32.load (local.get $r)) (i32.const 6)) (then unreachable))
      (local.set $source (i32.add (local.get $src) (local.get $offset)))
      (local.set $destination (i32.add (local.get $dst) (local.get $offset)))
      (i32.store offset=4 (local.get $destination) (local.get $index))
      (if (i32.lt_u (local.get $index) (i32.load offset=4 (local.get $source)))
        (then
          (i32.store offset=16 (local.get $p) (local.get $index))
          (local.set $src (i32.add (i32.load (local.get $source))
            (i32.mul (local.get $index) (i32.load offset=24 (local.get $r)))))
          (local.set $dst (i32.add (i32.load (local.get $destination))
            (i32.mul (local.get $index) (i32.load offset=24 (local.get $r)))))
          (local.set $ty (i32.load offset=16 (local.get $r)))
          (local.set $cursor (i32.const 0))
          (call $init (local.get $ty) (local.get $src) (local.get $dst))
          (br $walk)))
      (call $pop)
      (local.set $cursor (i32.add (local.get $offset) (i32.const 1)))
      (br $walk)))
    ;; Preserve status across arbitrary nested Drop calls. Failed leaf is excluded.
    (call $drop (local.get $ty) (local.get $dst) (local.get $cursor))
    (block $unwound (loop $unwind
      (br_if $unwound (i32.eq (global.get $used) (local.get $base)))
      (local.set $p (call $top))
      (if (i32.ne (i32.load offset=20 (local.get $p)) (i32.const 2)) (then unreachable))
      (local.set $src (i32.load (local.get $p)))
      (local.set $dst (i32.load offset=4 (local.get $p)))
      (local.set $ty (i32.load offset=8 (local.get $p)))
      (local.set $offset (i32.load offset=12 (local.get $p)))
      ;; All frame fields needed below are cached BEFORE its slot can be reused.
      (call $pop)
      (call $save (local.get $ty) (local.get $src) (local.get $offset) (i32.const 0))
      (local.set $leaf (call $foundType))
      (if (i32.or (i32.eq (local.get $leaf) (i32.const -1))
                  (i32.ne (call $foundOffset) (local.get $offset))) (then unreachable))
      (local.set $r (call $row (local.get $leaf)))
      (if (i32.ne (i32.load (local.get $r)) (i32.const 6)) (then unreachable))
      ;; This vector's length includes only COMPLETE elements. Its unfinished
      ;; current element was just unwound separately; never whole-drop that element.
      (call $drop (local.get $leaf) (i32.add (local.get $dst) (local.get $offset))
        (i32.load offset=4 (local.get $r)))
      (call $drop (local.get $ty) (local.get $dst) (local.get $offset))
      (br $unwind)))
    (local.get $status))
)
