interface Pair extends ZrynaStruct { left: i32; right: i32; slots: FixedArray<i32, 2>; }
function assign(loan: BorrowMut<i32>, value: i32): i32 { loan = value; return loan; }
export function entry(): i32 { let root: Pair = Pair({ left: 1, right: 2, slots: FixedArray<i32, 2>([3, 4]) }); { const left: BorrowMut<i32> = borrowMut(root.left); const right: BorrowMut<i32> = borrowMut(root.right); const zero: Borrow<i32> = borrow(root.slots[0]); const one: BorrowMut<i32> = borrowMut(root.slots[1]); const a: i32 = assign(left, 11); const b: i32 = assign(right, 13); const z: i32 = zero; one = 17; } return root.left + root.right + root.slots[0] + root.slots[1]; }
