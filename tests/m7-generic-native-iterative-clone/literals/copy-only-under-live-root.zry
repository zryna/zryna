interface Node<T extends ZrynaValue> extends ZrynaEnum { leaf: T; branch: Vec<Node<T>>; }
export function entry(depth: i32): i32 {
  let root: Node<String> = Node.leaf<String>("x");
  let count: i32 = 0;
  while (count < depth) {
    const prior: Node<String> = root;
    const children: Vec<Node<String>> = Vec<Node<String>>([prior]);
    root = Node.branch<String>(children);
    count = count + 1;
  }
  return clone(depth);
}
