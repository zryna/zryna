interface Duo<T extends ZrynaValue> extends ZrynaStruct { first: T; second: T; }
export function entry(): i32 { const owner: Duo<String> = Duo<String>({ first: "a", second: "b" }); { const loan: Borrow<String> = borrow(owner.second); const taken: String = owner.first; const copied: String = clone(loan); } return 37; }
