function consume(value: Vec<i32>): i32 { return value[0] + value[1]; }
function step(): i32 {
  let values: Vec<i32> = Vec<i32>([]);
  push(values, 7);
  push(values, 11);
  return consume(values);
}
export function entry(trips: i32): i32 {
  let count: i32 = 0;
  let total: i32 = 0;
  while (count < trips) {
    total = total + step();
    count = count + 1;
  }
  return total;
}
