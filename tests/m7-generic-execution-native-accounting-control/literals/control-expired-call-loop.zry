function expired(): Weak<i32> {
  const owner: Shared<i32> = shared(7);
  return downgrade(owner);
}
function step(): i32 {
  const weak: Weak<i32> = expired();
  upgradeWeak(weak, (value) => { return 31; }, () => { return 37; });
}
export function entry(trips: i32): i32 {
  let count: i32 = 0;
  let total: i32 = 0;
  while (count < trips) {
    total = total + step();
    count = count + 1;
  }
  return total;
}
