interface Pair<A extends ZrynaValue, B extends ZrynaValue> extends ZrynaStruct { left: A; right: B; } interface Outer<T extends ZrynaValue> extends ZrynaStruct { left: Pair<T,T>; right: T; } export function entry(): i32 { const earlierRoot: String = "E"; const outer: Outer<String> = Outer<String>({ right: clone(earlierRoot), left: Pair<String,String>({ right: "R", left: "L" }) }); return 7; }