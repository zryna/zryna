interface Inner extends ZrynaStruct { code: i32; } interface Plain extends ZrynaStruct { inner: Inner; } interface Pair<A extends ZrynaValue, B extends ZrynaValue> extends ZrynaStruct { left: A; right: B; } export function entry(): i32 { const plain: Plain = Plain({ inner: Inner({ code: 7 }) }); const forward: Pair<i32,bool> = Pair<i32,bool>({ left: plain.inner.code, right: true }); const reverse: Pair<bool,i32> = Pair<bool,i32>({ left: false, right: forward.left }); return reverse.right; }