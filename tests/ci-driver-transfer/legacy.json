osignSource = (Get-Command cosign).Source\nnet user $user $passwordText /add /passwordchg:no\nif ($LASTEXITCODE -ne 0) { throw 'could not create the standard test user' }\ntry {\n  New-Item -ItemType Directory -Path $workRoot -Force | Out-Null\n  New-Item -ItemType Directory -Path $outputRoot -Force | Out-Null\n  $node = Join-Path $userRoot 'node.exe'\n  $cosign = Join-Path $userRoot 'cosign.exe'\n  Copy-Item -LiteralPath $nodeSource -Destination $node\n  Copy-Item -LiteralPath $cosignSource -Destination $cosign\n  $hostile = Join-Path $userRoot 'hostile-bin'\n  New-Item -ItemType Directory -Path $hostile | Out-Null\n  Copy-Item -LiteralPath \"$env:SystemRoot\\System32\\cmd.exe\" `\n    -Destination (Join-Path $hostile 'zryna.exe')\n  $env:PATH = \"$hostile;$env:PATH\"\n  icacls $env:GITHUB_WORKSPACE /grant \"${user}:(OI)(CI)RX\" /T /Q | Out-Null\n  icacls $userRoot /grant \"${user}:(OI)(CI)M\" /T /Q | Out-Null\n  icacls $outputRoot /grant \"${user}:(OI)(CI)M\" /T /Q | Out-Null\n  icacls $userRoot /setowner $user /T /Q | Out-Null\n  icacls $outputRoot /setowner $user /T /Q | Out-Null\n  $localAppData = Join-Path $userRoot 'AppData\\Local'\n  New-Item -ItemType Directory -Path $localAppData -Force | Out-Null\n  icacls $localAppData /setowner $user /T /Q | Out-Null\n  $env:HOME = $userRoot\n  $env:USERPROFILE = $userRoot\n  $env:LOCALAPPDATA = $localAppData\n  $env:TEMP = $userRoot\n  $env:TMP = $userRoot\n  $arguments = @(\n    'scripts/distribution-release/run-published-acceptance.mjs',\n    '--cosign', $cosign,\n    '--directory', $releaseRoot, '--output', $outputRoot,\n    '--state', $statePath, '--target', $env:ZRYNA_TARGET, '--work', $workRoot\n  )\n  $process = Start-Process -FilePath $node -ArgumentList $arguments `\n    -WorkingDirectory $env:GITHUB_WORKSPACE -Credential $credential -LoadUserProfile `\n    -RedirectStandardOutput $stdout -RedirectStandardError $stderr -Wait -PassThru\n  Get-Content -LiteralPath $stdout\n  if ($process.ExitCode -ne 0) {\n    G