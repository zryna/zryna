interface Packet<T extends ZrynaValue> extends ZrynaEnum { none: ZrynaNone; item: T; }
function consume(value: String): i32 { return 5; }
export function entry(): i32 {
  const root: Packet<String> = Packet.item<String>("nominal");
  const loan: Borrow<Packet<String>> = borrow(root);
  const seen: i32 = match(loan, { "Packet.none": () => 0, "Packet.item": (payload) => consume(clone(payload)) });
  const copied: Packet<String> = clone(loan);
  return seen;
}
