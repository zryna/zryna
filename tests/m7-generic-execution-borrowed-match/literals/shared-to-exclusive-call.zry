interface Packet<T extends ZrynaValue> extends ZrynaEnum { none: ZrynaNone; item: T; }
function overwrite(value: BorrowMut<String>): i32 { value = clone(value); value = "new"; return 13; }
export function entry(): i32 {
  const root: Packet<String> = Packet.item<String>("owned");
  return match(borrow(root), { "Packet.none": () => 0, "Packet.item": (payload) => overwrite(payload) });
}
