interface Signal extends ZrynaEnum {
  quiet: ZrynaNone;
  yes: String;
  no: String;
}
export function entry(): i32 {
  const value: Option<Signal> = Option.some<Signal>(Signal.yes("L"));
  const copied: Option<Signal> = clone(value);
  return match(copied, {
    "Option.none": () => 0,
    "Option.some": (signal) => match(signal, {
      "Signal.quiet": () => 0,
      "Signal.yes": (item) => 7,
      "Signal.no": (item) => 9,
    }),
  });
}
