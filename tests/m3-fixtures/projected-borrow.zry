interface Pair extends ZrynaStruct {
  x: i32;
  y: i32;
}

interface State extends ZrynaStruct {
  left: Pair;
  right: Pair;
  slots: FixedArray<i32, 2>;
}

function projected(): State {
  let root: State = State({
    left: Pair({ x: 1, y: 2 }),
    right: Pair({ x: 3, y: 4 }),
    slots: FixedArray<i32, 2>([5, 6]),
  });
  {
    const leftX: BorrowMut<i32> = borrowMut(root.left.x);
    const rightX: BorrowMut<i32> = borrowMut(root.right.x);
    const leftBefore: i32 = leftX;
    leftX = 10;
    rightX = 30;
    const leftSibling: i32 = root.left.y;
    const slotZero: Borrow<i32> = borrow(root.slots[0]);
    const slotZeroAgain: Borrow<i32> = borrow(slotZero);
    const zeroValue: i32 = slotZero;
    const zeroAgainValue: i32 = slotZeroAgain;
    const slotOne: BorrowMut<i32> = borrowMut(root.slots[1]);
    slotOne = 60;
    const oneValue: i32 = slotOne;
  }
  return root;
}
