{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zryna.com/schemas/zryna-preassembly-gates-v1.schema.json",
  "title": "Zryna preassembly gates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "repository", "workflow", "runId", "runAttempt", "runUrl", "sourceCommit",
    "requiredContexts", "requiredJobs"
  ],
  "properties": {
    "format": { "const": "zryna.preassembly-gates.v1" },
    "repository": { "const": "https://github.com/zryna/zryna" },
    "workflow": { "const": ".github/workflows/ci.yml" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
    "runUrl": {
      "type": "string",
      "minLength": 50,
      "maxLength": 128,
      "pattern": "^https://github.com/zryna/zryna/actions/runs/[1-9][0-9]{0,19}$"
    },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "requiredContexts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[ -~]+$" }
    },
    "requiredJobs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "conclusion", "sourceCommit", "runId", "runAttempt", "jobId", "checkRunId"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[ -~]+$" },
        "conclusion": { "const": "success" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "runId": { "$ref": "#/$defs/numericId" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "jobId": { "$ref": "#/$defs/numericId" },
        "checkRunId": { "$ref": "#/$defs/numericId" }
      }
    },
    "numericId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
  }
}
