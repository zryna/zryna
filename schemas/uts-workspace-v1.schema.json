{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UTS compiler workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "profile", "members", "adapters", "outputs"],
  "properties": {
    "$schema": { "const": "./schemas/uts-workspace-v1.schema.json" },
    "version": { "const": 1 },
    "profile": { "const": "uts-compiler-workspace-v1" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "kind", "dependencies", "allowedEntries"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "root": { "type": "string", "pattern": "^(apps|crates)/[a-z][a-z0-9-]+$" },
          "kind": {
            "enum": ["foundation", "frontend", "compiler", "backend", "orchestrator", "application"]
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
          },
          "allowedEntries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" }
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "protocolVersion", "toolchain", "allowedEntries"],
        "properties": {
          "id": { "type": "string" },
          "root": { "type": "string", "pattern": "^adapters/[a-z0-9-]+$" },
          "protocolVersion": { "type": "integer", "minimum": 1 },
          "toolchain": { "type": "string" },
          "allowedEntries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["target", ".uts/cache", ".uts/out"] }
    }
  }
}
