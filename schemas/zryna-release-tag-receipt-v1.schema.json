{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zryna.com/schemas/zryna-release-tag-receipt-v1.schema.json",
  "title": "Zryna protected release tag receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "source", "workflow"],
  "properties": {
    "format": { "const": "zryna.release-tag-receipt.v1" },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "tagType",
        "tagObject",
        "commit",
        "tree",
        "sourceDateEpoch"
      ],
      "properties": {
        "repository": { "const": "https://github.com/zryna/zryna" },
        "ref": { "type": "string", "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "tagType": { "const": "annotated" },
        "tagObject": { "$ref": "#/$defs/objectId" },
        "commit": { "$ref": "#/$defs/objectId" },
        "tree": { "$ref": "#/$defs/objectId" },
        "sourceDateEpoch": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "const": ".github/workflows/release.yml" },
        "size": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "objectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
