{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zryna.com/schemas/zryna-distribution-files-v1.schema.json",
  "title": "Zryna bounded distribution file tuples v1",
  "description": "Wire shape only. Semantic admission additionally requires canonical bytes, exact role paths, sorted collision-free paths, existing license references, aggregate byte bounds and authenticated source material pins.",
  "type": "array",
  "maxItems": 512,
  "items": {
    "$ref": "#/$defs/file"
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._-]*(/[A-Za-z0-9@][A-Za-z0-9@._-]*){0,11}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256",
        "role",
        "mode",
        "material",
        "licenses"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "cli",
            "runtime",
            "provider",
            "metadata",
            "license",
            "notice"
          ]
        },
        "mode": {
          "enum": [
            420,
            493
          ]
        },
        "material": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "cli",
                  "runtime"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": 493
              }
            }
          },
          "else": {
            "properties": {
              "mode": {
                "const": 420
              },
              "size": {
                "type": "integer",
                "maximum": 16777216
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "metadata",
                  "license",
                  "notice"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "size": {
                "type": "integer",
                "maximum": 2097152
              }
            }
          }
        }
      ]
    }
  }
}
