{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zryna.com/schemas/zryna-syntax-v3.schema.json",
  "title": "Zryna provider-neutral control-flow syntax protocol v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files", "diagnostics"],
  "properties": {
    "schema_version": { "const": 3 },
    "files": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/sourceUnit" } },
    "diagnostics": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "span": { "type": "object", "additionalProperties": false, "required": ["file", "start", "end"], "properties": { "file": { "$ref": "#/$defs/u32" }, "start": { "$ref": "#/$defs/u32" }, "end": { "$ref": "#/$defs/u32" } } },
    "text": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "identifier": { "type": "object", "additionalProperties": false, "required": ["text", "span"], "properties": { "text": { "$ref": "#/$defs/text" }, "span": { "$ref": "#/$defs/span" } } },
    "typeKind": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "missing" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "named" }, "name": { "$ref": "#/$defs/text" } } }
    ] },
    "typeSyntax": { "type": "object", "additionalProperties": false, "required": ["span", "kind"], "properties": { "span": { "$ref": "#/$defs/span" }, "kind": { "$ref": "#/$defs/typeKind" } } },
    "parameter": { "type": "object", "additionalProperties": false, "required": ["span", "name", "type_syntax"], "properties": { "span": { "$ref": "#/$defs/span" }, "name": { "$ref": "#/$defs/identifier" }, "type_syntax": { "$ref": "#/$defs/typeSyntax" } } },
    "importBinding": { "type": "object", "additionalProperties": false, "required": ["span", "imported", "local", "as_span"], "properties": { "span": { "$ref": "#/$defs/span" }, "imported": { "$ref": "#/$defs/identifier" }, "local": { "$ref": "#/$defs/identifier" }, "as_span": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] } } },
    "specifier": { "type": "object", "additionalProperties": false, "required": ["text", "token_span", "value_span"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?:\\./|\\.\\./)(?![\\s\\S]*//)(?![\\s\\S]*[\\\\?#])(?![\\s\\S]*://)[\\u0001-\\u007F]*\\.zry$" }, "token_span": { "$ref": "#/$defs/span" }, "value_span": { "$ref": "#/$defs/span" } } },
    "import": { "type": "object", "additionalProperties": false, "required": ["span", "import_span", "bindings", "from_span", "specifier", "semicolon_span"], "properties": { "span": { "$ref": "#/$defs/span" }, "import_span": { "$ref": "#/$defs/span" }, "bindings": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/importBinding" } }, "from_span": { "$ref": "#/$defs/span" }, "specifier": { "$ref": "#/$defs/specifier" }, "semicolon_span": { "$ref": "#/$defs/span" } } },
    "block": { "type": "object", "additionalProperties": false, "required": ["span", "open_brace_span", "statements", "close_brace_span"], "properties": { "span": { "$ref": "#/$defs/span" }, "open_brace_span": { "$ref": "#/$defs/span" }, "statements": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/u32" } }, "close_brace_span": { "$ref": "#/$defs/span" } } },
    "elseClause": { "type": "object", "additionalProperties": false, "required": ["keyword_span", "block"], "properties": { "keyword_span": { "$ref": "#/$defs/span" }, "block": { "$ref": "#/$defs/u32" } } },
    "statementKind": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "keyword_span", "mutable", "name", "type_syntax", "equals_span", "initializer", "semicolon_span"], "properties": { "kind": { "const": "local-declaration" }, "keyword_span": { "$ref": "#/$defs/span" }, "mutable": { "type": "boolean" }, "name": { "$ref": "#/$defs/identifier" }, "type_syntax": { "$ref": "#/$defs/typeSyntax" }, "equals_span": { "$ref": "#/$defs/span" }, "initializer": { "$ref": "#/$defs/u32" }, "semicolon_span": { "$ref": "#/$defs/span" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "target", "equals_span", "value", "semicolon_span"], "properties": { "kind": { "const": "assignment" }, "target": { "$ref": "#/$defs/identifier" }, "equals_span": { "$ref": "#/$defs/span" }, "value": { "$ref": "#/$defs/u32" }, "semicolon_span": { "$ref": "#/$defs/span" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "keyword_span", "value", "semicolon_span"], "properties": { "kind": { "const": "return" }, "keyword_span": { "$ref": "#/$defs/span" }, "value": { "$ref": "#/$defs/u32" }, "semicolon_span": { "$ref": "#/$defs/span" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "block"], "properties": { "kind": { "const": "block" }, "block": { "$ref": "#/$defs/u32" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "keyword_span", "open_paren_span", "condition", "close_paren_span", "then_block", "else_clause"], "properties": { "kind": { "const": "if" }, "keyword_span": { "$ref": "#/$defs/span" }, "open_paren_span": { "$ref": "#/$defs/span" }, "condition": { "$ref": "#/$defs/u32" }, "close_paren_span": { "$ref": "#/$defs/span" }, "then_block": { "$ref": "#/$defs/u32" }, "else_clause": { "anyOf": [{ "$ref": "#/$defs/elseClause" }, { "type": "null" }] } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "keyword_span", "open_paren_span", "condition", "close_paren_span", "body_block"], "properties": { "kind": { "const": "while" }, "keyword_span": { "$ref": "#/$defs/span" }, "open_paren_span": { "$ref": "#/$defs/span" }, "condition": { "$ref": "#/$defs/u32" }, "close_paren_span": { "$ref": "#/$defs/span" }, "body_block": { "$ref": "#/$defs/u32" } } }
    ] },
    "statement": { "type": "object", "additionalProperties": false, "required": ["span", "kind"], "properties": { "span": { "$ref": "#/$defs/span" }, "kind": { "$ref": "#/$defs/statementKind" } } },
    "binaryKind": { "type": "object", "additionalProperties": false, "required": ["kind", "operator_span", "lhs", "rhs"], "properties": { "kind": { "enum": ["addition", "subtraction", "multiplication", "equal", "not-equal", "less-than", "less-equal", "greater-than", "greater-equal"] }, "operator_span": { "$ref": "#/$defs/span" }, "lhs": { "$ref": "#/$defs/u32" }, "rhs": { "$ref": "#/$defs/u32" } } },
    "expressionKind": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "reference" }, "name": { "$ref": "#/$defs/identifier" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "bool-literal" }, "value": { "type": "boolean" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "spelling"], "properties": { "kind": { "const": "i32-literal" }, "spelling": { "type": "string", "maxLength": 64, "pattern": "^(?:0|-?[1-9][0-9]*)$" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "operator_span", "operand"], "properties": { "kind": { "const": "negation" }, "operator_span": { "$ref": "#/$defs/span" }, "operand": { "$ref": "#/$defs/u32" } } },
      { "$ref": "#/$defs/binaryKind" },
      { "type": "object", "additionalProperties": false, "required": ["kind", "callee", "open_paren_span", "arguments", "close_paren_span"], "properties": { "kind": { "const": "call" }, "callee": { "$ref": "#/$defs/identifier" }, "open_paren_span": { "$ref": "#/$defs/span" }, "arguments": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/u32" } }, "close_paren_span": { "$ref": "#/$defs/span" } } }
    ] },
    "expression": { "type": "object", "additionalProperties": false, "required": ["span", "kind"], "properties": { "span": { "$ref": "#/$defs/span" }, "kind": { "$ref": "#/$defs/expressionKind" } } },
    "body": { "type": "object", "additionalProperties": false, "required": ["span", "root_block", "blocks", "statements", "expressions"], "properties": { "span": { "$ref": "#/$defs/span" }, "root_block": { "$ref": "#/$defs/u32" }, "blocks": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/block" } }, "statements": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/statement" } }, "expressions": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/expression" } } } },
    "function": { "type": "object", "additionalProperties": false, "required": ["span", "export_span", "function_span", "name", "parameters", "result_type", "body"], "properties": { "span": { "$ref": "#/$defs/span" }, "export_span": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] }, "function_span": { "$ref": "#/$defs/span" }, "name": { "$ref": "#/$defs/identifier" }, "parameters": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/parameter" } }, "result_type": { "$ref": "#/$defs/typeSyntax" }, "body": { "$ref": "#/$defs/body" } } },
    "portablePath": { "type": "string", "minLength": 1, "maxLength": 1024, "allOf": [{ "pattern": "^(?!/)(?!(?:[^/]*/){32})(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[. ](?:/|$))(?!.*[\\\\<>:\"|?*])[\\x20-\\x7E]+$" }, { "pattern": "^(?![^/]{256})(?!.*\\/[^/]{256}).*$" }, { "pattern": "^(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[^/]*)?(?:/|$)).*$" }] },
    "sourceUnit": { "type": "object", "additionalProperties": false, "required": ["id", "path", "imports", "functions"], "properties": { "id": { "$ref": "#/$defs/u32" }, "path": { "$ref": "#/$defs/portablePath" }, "imports": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/import" } }, "functions": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/function" } } } },
    "diagnosticLocation": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "global" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "span"], "properties": { "kind": { "const": "source" }, "span": { "$ref": "#/$defs/span" } } }] },
    "diagnostic": { "type": "object", "additionalProperties": false, "required": ["code", "severity", "location", "message", "guidance"], "properties": { "code": { "$ref": "#/$defs/text" }, "severity": { "enum": ["error", "warning"] }, "location": { "$ref": "#/$defs/diagnosticLocation" }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 }, "guidance": { "type": "string", "minLength": 1, "maxLength": 4096 } } }
  }
}
